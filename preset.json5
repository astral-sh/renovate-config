{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Always enable the dependency dashboard.
  dependencyDashboard: true,

  extends: [
    // Recreate `config:best-practices`, except for presets that conflict with
    // our organization-wide policy:
    //
    // `:pinDevDependencies` uses a package rule that overrides the desired
    // top-level `rangeStrategy` and `cargo.rangeStrategy` settings below.
    //
    // `security:minimumReleaseAgeNpm` applies a shorter, npm-specific cooldown
    // that would override our blanket minimum release age.
    //
    // `:maintainLockFilesWeekly` conflicts with our disabled-by-default lock
    // file maintenance policy; individual repositories can opt in instead.
    //
    // See: https://docs.renovatebot.com/presets-config/#configbest-practices
    'config:recommended',
    'docker:pinDigests',
    // This preset already includes `helpers:pinGitHubActionDigests`.
    'helpers:pinGitHubActionDigestsToSemver',
    ':configMigration',
    'abandonments:recommended',
  ],

  // Default range strategy for dependencies.
  // NOTE: We override the range strategy from best-practices here (and below),
  // because it results in exceedingly noisy updates to non-lockfile dependency files.
  rangeStrategy: 'auto',

  // Additionally, we set the range strategy for cargo to 'update-lockfile' to avoid
  // unnecessary updates to Cargo.toml files.
  cargo: {
    rangeStrategy: 'update-lockfile',
  },

  // Keep pre-commit hook revisions current; Renovate disables this manager by default.
  'pre-commit': {
    enabled: true,
  },

  // Apply a blanket cooldown of 30 days to third-party dependency updates.
  minimumReleaseAge: '30 days',

  // Fail closed when a registry does not provide a release timestamp.
  minimumReleaseAgeBehaviour: 'timestamp-required',

  // Do not create a branch or PR until the release has passed its cooldown.
  internalChecksFilter: 'strict',

  // PR settings.
  // Our PRs are created immediately. We do this instead of not-pending because the latter
  // makes Renovate wait an additional 24 hours before creating the PR when there are no checks.
  prCreation: 'immediate',

  // By default, Renovate will only create 2 PRs in any single hourly interval.
  // But we only allow Renovate to create PRs between midnight and 4am on Monday
  // in most of our repos, so this is not sufficient in general. Per the docs,
  // 0 means "no limit": <https://docs.renovatebot.com/configuration-options/#prhourlylimit>
  prHourlyLimit: 0,

  // Similarly, by default, Renovate will not create any new PRs if it already has 10 open
  // on any repo, but that isn't generally what we want: we generally want dependency update PRs
  // for all available dependencies. Per the docs, 0 means "no limit":
  // <https://docs.renovatebot.com/configuration-options/#prconcurrentlimit>
  prConcurrentLimit: 0,

  // Conventions: we generally don't use semantic commits, and we add an "internal" label to all dependency update PRs.
  semanticCommits: 'disabled',
  addLabels: ['internal'],

  separateMajorMinor: false,

  // These notifications are very noisy.
  suppressNotifications: ['prEditedNotification'],

  // Lock file maintenance configuration
  // We don't enable this by default, since it doesn't interact well with
  // minimumReleaseAge.
  // See: <https://github.com/renovatebot/renovate/discussions/13460>
  lockFileMaintenance: {
    enabled: false,
    schedule: ['before 4am on monday'],
  },

  customManagers: [
    // Opt in with a workflow comment so tool versions and checksums update together.
    // See README.md for the annotation format.
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: "(?<currentValue>[^"\\r\\n]+)"(?:\\s+checksum: "(?<currentDigest>[a-f0-9]{64})")?',
      ],
      versioningTemplate: 'semver',
    },
  ],

  packageRules: [
    // Pin the version already in use immediately. Waiting to pin would leave
    // mutable GitHub Action and container references vulnerable to tampering.
    {
      description: 'Pin existing dependency references without a cooldown',
      matchUpdateTypes: ['pinDigest'],
      minimumReleaseAge: null,
    },
    // All lock file maintenance: group PRs by manager.
    {
      description: 'Group lockfile updates by manager',
      matchUpdateTypes: ['lockFileMaintenance'],
      groupName: '{{manager}} lockfile updates',
      commitMessageSuffix: 'for {{manager}}',
    },
    // Artifact upload and download actions must remain compatible with each other.
    {
      description: 'Keep GitHub artifact upload and download actions in sync',
      groupName: 'Artifact GitHub Actions dependencies',
      matchManagers: ['github-actions'],
      matchDatasources: ['gitea-tags', 'github-tags'],
      matchPackageNames: ['actions/upload-artifact', 'actions/download-artifact'],
    },
    // Astral's shared actions use YYYY.MM.DD.N tags.
    {
      description: 'Use calendar versioning for our shared GitHub Actions',
      matchManagers: ['github-actions'],
      matchPackageNames: ['astral-sh/github-actions'],
      extractVersion: '^(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)$',
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$',
    },
    // Disable the cooldown for packages sourced from our GitHub repositories.
    {
      description: 'Disable minimum release age checks for our own source repositories',
      matchSourceUrls: ['https://github.com/astral-sh/**'],
      minimumReleaseAge: null,
    },
    // GitHub: cover our repositories even when source metadata is unavailable.
    {
      description: 'Disable minimum release age checks for our own GitHub dependencies',
      matchDatasources: ['github-*'],
      matchPackageNames: ['astral-sh/**'],
      minimumReleaseAge: null,
    },
    // Docker and npm: cover our published namespaces when source metadata is unavailable.
    {
      description: 'Disable minimum release age checks for our own container images',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/astral-sh/**', 'astral/uv', 'docker.io/astral/uv'],
      minimumReleaseAge: null,
    },
    {
      description: 'Disable minimum release age checks for our own npm packages',
      matchDatasources: ['npm'],
      matchPackageNames: ['@astral-sh/**'],
      minimumReleaseAge: null,
    },
    // uv-pre-commit installs uv, so group its updates with uv workflow pins.
    //
    // Note that the mirror may publish later, so Renovate *can* still sometimes 
    // propose a workflow update before the matching hook is available. This
    // grouping does however make this mismatch much less likely to happen.
    {
      description: 'Group uv and its pre-commit hook updates',
      matchManagers: ['custom.regex', 'pre-commit'],
      matchPackageNames: ['astral-sh/uv', 'astral-sh/uv-pre-commit'],
      groupName: 'uv',
    },
    // The custom manager updates uv workflow versions and their checksums together.
    {
      description: 'Disable updates to uv workflow versions that leave checksums unchanged',
      matchManagers: ['github-actions'],
      matchDepTypes: ['uses-with'],
      matchPackageNames: ['astral-sh/uv'],
      matchFileNames: ['.github/workflows/**'],
      enabled: false,
    },
    // Python: disable minimum release age for our own packages.
    {
      description: 'Disable minimum release age checks for our own Python packages',
      matchDatasources: ['pypi'],
      matchPackageNames: ['ruff', 'uv', 'ty', 'uv-build'],
      minimumReleaseAge: null,
    },
    // Docker: use descriptive group name for container image digest updates.
    {
      groupName: 'container image digests',
      matchDatasources: ['docker'],
      matchUpdateTypes: ['pinDigest'],
      description: 'Update container image digests',
      commitMessageAction: 'Update',
      commitMessageTopic: 'container image digests',
    },
  ],

  vulnerabilityAlerts: {
    enabled: true,
    // The security label already identifies these PRs; keep their titles consistent
    // with other dependency updates instead of appending `[SECURITY]`.
    commitMessageSuffix: null,
    // Do not inherit repository-specific labels that skip release or build checks.
    labels: ['internal', 'security'],
    // Never delay a fix for a known vulnerability behind the release cooldown.
    minimumReleaseAge: null,
    vulnerabilityFixStrategy: 'lowest',
  },
}
